@mode(host.native)

# imgfx: entry point. Keep this file thin: all behaviour lives in
# cli.app.run so that tests can call it with an argument list.
#
# Runtime: host.native. main() gets the command line. The same source runs
# two ways. `make build` compiles it with every module it imports ahead of
# time into the native binary build/imgfx (Stage0, `loup-bootstrap build
# --target native`; reference counting, no interpreter). `make run` and
# `make parity` interpret it with Stage0's `loup-bootstrap run
# source/main.lphc --`; parity runs tests/e2e.sh through the interpreter,
# which must write the same bytes as the binary. (Not the self-hosted
# `loup run`: in 1.26.0 it drops a writeBytes of 26,210 bytes or more.)

from cli.app import (run);

func main(): int {
    return run(runtime.args());
}
