@mode(host.native)

# Application identity and exit statuses of imgfx. Keep APP_NAME and
# APP_VERSION in step with `name` and `version` in package.lppkg.
#
# Runtime: host.native. Constants only, compiled into the native binary
# build/imgfx by `make build` (Stage0 native build) and into each test
# binary that imports them; `make run` and `make parity` interpret them with
# `loup-bootstrap run`.

pub const APP_NAME: string = "imgfx";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Apply image filters to PGM and PPM images (P2, P3, P5, P6).";

# Exit statuses returned by main().
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
pub const EXIT_USAGE: int = 2;
