@mode(host.native)

# Filter specifications: `name` or `name=ARGS`, checked before the image is
# read. Kinds are compared with == rather than `match`: in Loup 1.26.0 a
# string `match` always takes its `_` arm in native code.

pub struct Filter {
    pub kind: string;
    # meaning depends on the kind (see parse_filter)
    pub a: int;
    pub b: int;
    pub c: int;
    pub d: int;
}

pub const KINDS: string = "grayscale, invert, brightness=N, contrast=F, blur[=R], gaussian[=R], sobel, nearest=WxH, bilinear=WxH, crop=X,Y,W,H, flip=h|v";

func filter(kind: string, a: int, b: int, c: int, d: int): Filter {
    return Filter(kind = kind, a = a, b = b, c = c, d = d);
}

# A decimal integer with an optional sign, or None.
pub func parse_int(text: string): Option[int] {
    var digits = text;
    var sign = 1;
    if (text.startsWith("-") or text.startsWith("+")) {
        sign = if (text.startsWith("-")) { -1 } else { 1 };
        digits = text.slice(1);
    }
    if (digits.len() == 0 or digits.len() > 9) {
        return None;
    }
    var value = 0;
    for (ch in digits) {
        let d = "0123456789".index_of(ch);
        if (d < 0) {
            return None;
        }
        value = value * 10 + d;
    }
    return Some(sign * value);
}

# A non-negative decimal with up to three fractional digits, in thousandths:
# "1.5" -> 1500, ".25" -> 250, "2" -> 2000.
pub func parse_decimal_milli(text: string): Option[int] {
    let parts = text.split(".");
    if (parts.len() > 2 or text.len() == 0 or text == ".") {
        return None;
    }
    let whole_text = parts[0];
    let frac_text = if (parts.len() == 2) { parts[1] } else { "" };
    if (frac_text.len() > 3 or whole_text.startsWith("-") or whole_text.startsWith("+")) {
        return None;
    }
    let whole = if (whole_text.len() == 0) { 0 } else { parse_int(whole_text).unwrap_or(-1) };
    if (whole < 0) {
        return None;
    }
    var frac = 0;
    var scale = 100;
    for (ch in frac_text) {
        let d = "0123456789".index_of(ch);
        if (d < 0) {
            return None;
        }
        frac += d * scale;
        scale = scale / 10;
    }
    return Some(whole * 1000 + frac);
}

# "WxH" -> (W, H), each 1..16384.
pub func parse_size(text: string): Option[(int, int)] {
    let parts = text.split("x");
    if (parts.len() != 2) {
        return None;
    }
    let w = parse_int(parts[0]).unwrap_or(0);
    let h = parse_int(parts[1]).unwrap_or(0);
    if (w < 1 or h < 1 or w > 16384 or h > 16384 or parts[0].startsWith("+") or parts[1].startsWith("+")) {
        return None;
    }
    return Some((w, h));
}

func radius(name: string, value: string, has_value: bool, max: int): Result[Filter, string] {
    if (!has_value) {
        return Ok(filter(name, 1, 0, 0, 0));
    }
    let r = parse_int(value).unwrap_or(0);
    if (r < 1 or r > max) {
        return Err(i"'{$ name $}' needs a radius from 1 to {$ max $}, not '{$ value $}'");
    }
    return Ok(filter(name, r, 0, 0, 0));
}

# Parses one filter specification.
#   brightness: a = N        contrast: a = factor in thousandths
#   blur, gaussian: a = R    nearest, bilinear: a = W, b = H
#   crop: a, b, c, d = X, Y, W, H    flip: a = 0 (h) or 1 (v)
pub func parse_filter(spec: string): Result[Filter, string] {
    let eq = spec.index_of("=");
    let has_value = eq >= 0;
    let name = if (has_value) { spec.slice(0, eq) } else { spec };
    let value = if (has_value) { spec.slice(eq + 1) } else { "" };

    if (name == "grayscale" or name == "invert" or name == "sobel") {
        if (has_value) {
            return Err(i"'{$ name $}' takes no argument");
        }
        return Ok(filter(name, 0, 0, 0, 0));
    }
    if (name == "blur") {
        return radius(name, value, has_value, 25);
    }
    if (name == "gaussian") {
        return radius(name, value, has_value, 8);
    }
    if (!has_value) {
        if (name == "brightness" or name == "contrast" or name == "nearest" or name == "bilinear" or name == "crop" or name == "flip") {
            return Err(i"'{$ name $}' needs an argument: '{$ name $}=...'");
        }
        return Err(i"unknown filter '{$ name $}'");
    }
    if (name == "brightness") {
        let n = parse_int(value).unwrap_or(1000);
        if (n < -255 or n > 255) {
            return Err(i"'brightness' needs a number from -255 to 255, not '{$ value $}'");
        }
        return Ok(filter(name, n, 0, 0, 0));
    }
    if (name == "contrast") {
        let f = parse_decimal_milli(value).unwrap_or(-1);
        if (f < 0 or f > 10000) {
            return Err(i"'contrast' needs a factor from 0 to 10 (up to 3 decimals), not '{$ value $}'");
        }
        return Ok(filter(name, f, 0, 0, 0));
    }
    if (name == "nearest" or name == "bilinear") {
        return match parse_size(value) {
            Some((w, h)) => Ok(filter(name, w, h, 0, 0)),
            None => Err(i"'{$ name $}' needs a size WxH (1 to 16384 each), not '{$ value $}'"),
        };
    }
    if (name == "crop") {
        let parts = value.split(",");
        if (parts.len() == 4) {
            let x = parse_int(parts[0]).unwrap_or(-1);
            let y = parse_int(parts[1]).unwrap_or(-1);
            let w = parse_int(parts[2]).unwrap_or(0);
            let h = parse_int(parts[3]).unwrap_or(0);
            if (x >= 0 and y >= 0 and w >= 1 and h >= 1) {
                return Ok(filter(name, x, y, w, h));
            }
        }
        return Err(i"'crop' needs X,Y,W,H (X, Y from 0; W, H from 1), not '{$ value $}'");
    }
    if (name == "flip") {
        if (value == "h") {
            return Ok(filter(name, 0, 0, 0, 0));
        } else if (value == "v") {
            return Ok(filter(name, 1, 0, 0, 0));
        }
        return Err(i"'flip' needs h or v, not '{$ value $}'");
    }
    return Err(i"unknown filter '{$ name $}'");
}
