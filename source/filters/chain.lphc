@mode(host.native)

# Applies parsed imgfx filters to an image, left to right: the dispatch from
# a Filter's kind to the function that implements it, each filter timed as
# a profiler span.
#
# Runtime: host.native. Compiled into the native binary build/imgfx by
# `make build` (Stage0 native build); `make run` and `make parity` interpret
# the same code with Stage0's `loup-bootstrap run`.

from image.image import (Image);
from filters.spec import (Filter);
from filters.point import (grayscale, invert, brightness, contrast);
from filters.convolve import (box_blur, gaussian_blur, sobel);
from filters.geometry import (resize_nearest, resize_bilinear, crop, flip);
from debug.profiler import (Profiler);

pub func apply_filter(img: Image, f: Filter): Image {
    let k = f.kind;
    if (k == "grayscale") {
        return grayscale(img);
    } else if (k == "invert") {
        return invert(img);
    } else if (k == "brightness") {
        return brightness(img, f.a);
    } else if (k == "contrast") {
        return contrast(img, f.a);
    } else if (k == "blur") {
        return box_blur(img, f.a);
    } else if (k == "gaussian") {
        return gaussian_blur(img, f.a);
    } else if (k == "sobel") {
        return sobel(img);
    } else if (k == "nearest") {
        return resize_nearest(img, f.a, f.b);
    } else if (k == "bilinear") {
        return resize_bilinear(img, f.a, f.b);
    } else if (k == "crop") {
        return crop(img, f.a, f.b, f.c, f.d);
    }
    # parse_filter accepts no other kind, so what is left is flip.
    return flip(img, f.a == 1);
}

# Each filter runs inside a profiler span named after its position and kind
# ("2 gaussian"), so the same filter twice in a chain is timed twice.
pub safe func apply_all(img: Image, filters: list[Filter], edits prof: Profiler): Image {
    var current = img;
    for (k in 0..filters.len()) {
        let f = filters[k];
        prof.enter(str(k + 1) + " " + f.kind);
        current = apply_filter(current, f);
        prof.exit();
    }
    return current;
}
