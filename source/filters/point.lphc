@mode(host.native)

# imgfx filters that map each sample on its own: grayscale, invert,
# brightness and contrast.
#
# Runtime: host.native. Compiled into the native binary build/imgfx by
# `make build` (Stage0 native build); `make run` and `make parity` interpret
# the same code with Stage0's `loup-bootstrap run`. tests/point_test.lphc
# checks it in native test binaries.
#
# Structure: every filter here is a function of the sample alone, so each
# one is a lambda that lut() evaluates once per possible value into a
# 256-entry table, and map_samples() then only looks samples up.

from image.image import (Image, clamp_sample, round_div, to_gray);

pub func grayscale(img: Image): Image {
    return to_gray(img);
}

## The 256-entry table of `f`: entry v is f(v). `f` is `noescape`: it is
## only called during lut(), so a lambda may capture the caller's locals
## (the brightness delta, the contrast factor) without them outliving it.
pub func lut(f: noescape fn(int): int): list[int] {
    var table: list[int] = [];
    for (v in 0..256) {
        table.push(f(v));
    }
    return table;
}

func map_samples(img: Image, table: list[int]): Image {
    var out: list[int] = [];
    for (v in img.samples) {
        out.push(table[v]);
    }
    return img with (samples = out);
}

pub func invert(img: Image): Image {
    return map_samples(img, lut(func(v: int) => 255 - v));
}

pub func brightness(img: Image, delta: int): Image {
    return map_samples(img, lut(func(v: int) => clamp_sample(v + delta)));
}

# 128 + (v - 128) * factor, with the factor in thousandths.
pub func contrast(img: Image, milli: int): Image {
    return map_samples(img,
        lut(func(v: int) => clamp_sample(128 + round_div((v - 128) * milli, 1000))));
}
